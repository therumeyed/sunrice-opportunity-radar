# Postgres connection (Render provides this automatically when using render.yaml)
DATABASE_URL=postgresql://user:password@localhost:5432/sunrice_radar
PORT=3000

# --- DataForSEO (dataforseo.com) -- primary Trends provider ---
# Get credentials from your DataForSEO dashboard (login is an email, not a token).
# Required for the Search demand panel; that panel shows "Awaiting connection"
# without these rather than any invented numbers.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Daily hard ceiling on DataForSEO spend (USD, sum of each task's reported
# `cost`). Ingestion stops submitting new DataForSEO tasks once this is hit
# for the day and marks the remaining topics as skipped, not failed.
DATAFORSEO_DAILY_COST_CEILING_USD=5

# --- Apify (apify.com) -- powers Reddit, TikTok, Instagram and Pinterest signals ---
APIFY_TOKEN=

# Actor IDs -- override if you swap to a different actor (see README).
# APIFY_REDDIT_ACTOR_ID=trudax/reddit-scraper-lite
# APIFY_TIKTOK_ACTOR_ID=clockworks/tiktok-scraper
# APIFY_INSTAGRAM_ACTOR_ID=instaprism/instagram-hashtag-posts
# APIFY_PINTEREST_ACTOR_ID=automation-lab/pinterest-trends-scraper

# Feature flags -- each social/trend source is independently disableable. The
# dashboard works fully with any subset off; a disabled/misconfigured source
# just shows as `awaiting_connection` on Source health instead of breaking
# the rest of the report.
FEATURE_APIFY_REDDIT=true
FEATURE_APIFY_TIKTOK=true
FEATURE_APIFY_INSTAGRAM=true
FEATURE_APIFY_PINTEREST=true

# Reddit communities to scan (comma-separated, no r/).
APIFY_REDDIT_SUBREDDITS=MealPrepSunday,EatCheapAndHealthy,AskCulinary,budgetfood,AskAnAustralian

# TikTok/Instagram search terms and hashtags -- comma-separated. Defaults to
# the active topic library's queries if unset.
# APIFY_TIKTOK_SEARCH_TERMS=
# APIFY_INSTAGRAM_HASHTAGS=

# Pinterest Trends (trends.pinterest.com, via Apify) -- a second, independent
# trend source alongside DataForSEO Google Trends. Only offers Australia
# bundled with New Zealand ("AU+NZ", no standalone AU option for this actor),
# so it's AU+NZ data, not Australia-only like everything else here. Pulls
# Pinterest's own growing/top-monthly/seasonal trend lists and matches them
# locally against the topic library -- no separate query config needed.

# Feature flags for panels not yet built (kept here so the schema/UI already
# knows about them -- see README "What's deferred"). Leave false.
FEATURE_LOCAL_VISIBILITY=false
FEATURE_DIGITAL_AVAILABILITY=false
FEATURE_COMPETITOR_PULSE=false
FEATURE_CUSTOMER_VOICE=false

# --- Anthropic (console.anthropic.com) -- optional recommendation strategist ---
# Reads the same real evidence and score already computed deterministically
# and writes a sharper rationale, grounded in SunRice's real product range
# (src/products.js) -- e.g. spotting that a rising "biryani" query maps
# onto Basmati Rice. Never changes the score, confidence or which 3
# opportunities win; skipped gracefully (falls back to the deterministic
# template sentence) without this key set.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Admin ---
# Gates POST /admin/refresh (triggers an ingestion run on demand). On Render
# this is auto-generated (generateValue: true in render.yaml); set your own
# locally to test the endpoint.
ADMIN_TOKEN=

# Gates the two feedback-writing endpoints (POST /api/recommendations/:id/feedback,
# POST /api/feedback/:id/undo) -- a separate token from ADMIN_TOKEN since
# feedback is a distinct, lower-risk write than triggering a paid ingest run.
# Read access to feedback stays public, same as every other report read.
# On Render this is auto-generated (generateValue: true in render.yaml); set
# your own locally to test the endpoints.
EDITOR_TOKEN=
